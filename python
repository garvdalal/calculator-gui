def run_calculator():
    def click_button(value):
        current = display.get()
        display.set(current + value)

    def clear():
        display.set("")

    def calculate():
        try:
            result = eval(display.get())
            display.set(str(result))
        except Exception:
            display.set("Error")

    root = tk.Tk()
    root.title("Simple Calculator")

    display = tk.StringVar()
    entry = tk.Entry(root, textvariable=display, font=("Arial", 20), bd=10, insertwidth=2, width=14, borderwidth=4)
    entry.grid(row=0, column=0, columnspan=4)

    buttons = [
        ('7',1,0), ('8',1,1), ('9',1,2), ('+',1,3),
        ('4',2,0), ('5',2,1), ('6',2,2), ('-',2,3),
        ('1',3,0), ('2',3,1), ('3',3,2), ('*',3,3),
        ('0',4,0), ('.',4,1), ('C',4,2), ('/',4,3),
    ]

    for (text, row, col) in buttons:
        if text == 'C':
            action = clear
        else:
            action = lambda x=text: click_button(x)
        tk.Button(root, text=text, padx=20, pady=20, command=action).grid(row=row, column=col)

    tk.Button(root, text='=', padx=88, pady=20, command=calculate).grid(row=5, column=0, columnspan=4)

    root.mainloop()
